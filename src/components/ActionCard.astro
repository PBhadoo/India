---
import PartyChip from './PartyChip.astro';
import StatusPill from './StatusPill.astro';
import { fmtDate, fmtSigned } from '../lib/format.ts';
import { getCategory } from '../lib/taxonomy.ts';
import { pm, type ActionRow, type Site } from '../lib/site.ts';
interface Props { action: ActionRow; site: Site; showCategory?: boolean; showScore?: boolean }
const { action: a, site, showCategory = true, showScore = true } = Astro.props;
const cat = getCategory(a.data.category);
---
<article class="acard">
  <div class="meta">
    <StatusPill status={a.data.status} />
    {a.partyId && <PartyChip party={pm(site, a.partyId)} />}
    <time datetime={a.data.date.toISOString().slice(0, 10)}>{fmtDate(a.data.date)}</time>
    {showCategory && cat && <span>{cat.name}</span>}
    {a.data.level === 'state' && <span class="badge">State</span>}
    {a.data.developing && <span class="badge badge-live">Unsettled</span>}
  </div>
  <h3><a href={`/actions/${a.slug}/`}>{a.data.title}</a></h3>
  <p>{a.data.summary}</p>
  {showScore && a.score.scored && (
    <p class="small mono" style="margin-top:.4rem">Evidence points {fmtSigned(a.score.points)} (range {fmtSigned(a.score.low)} to {fmtSigned(a.score.high)})</p>
  )}
</article>
