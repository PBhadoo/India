---
import DossierStatus from './DossierStatus.astro';
import { KIND_LABEL } from '../lib/dossiers.ts';
import { fmtDate, isoDate } from '../lib/format.ts';
import { getCategory } from '../lib/taxonomy.ts';
import type { DossierRow } from '../lib/site.ts';
interface Props { dossier: DossierRow; showCategory?: boolean; compact?: boolean }
const { dossier: d, showCategory = true, compact = false } = Astro.props;
const cat = getCategory(d.data.category);
---
<article class="acard dcard">
  <div class="meta">
    <span class="badge badge-kind">{KIND_LABEL[d.data.kind] ?? d.data.kind}</span>
    <DossierStatus status={d.data.status} />
    {showCategory && cat && <span>{cat.name}</span>}
  </div>
  <h3><a href={`/dossiers/${d.slug}/`}>{d.data.title}</a></h3>
  {!compact && <p>{d.data.summary}</p>}
  <p class="small asof">Facts as of <time datetime={isoDate(d.data.asOf)}>{fmtDate(d.data.asOf)}</time></p>
</article>
