---
import { SOURCE_TYPE_LABEL } from '../lib/format.ts';
interface Props { sources: { title: string; url: string; publisher?: string; type?: string }[]; idPrefix?: string }
const { sources, idPrefix } = Astro.props;
---
<ol class="src-list">
  {sources.map((s, i) => (
    <li id={idPrefix ? `${idPrefix}${i + 1}` : undefined}>
      <div>
        <a href={s.url} rel="noopener">{s.title}</a>
        <div class="pub">
          {s.publisher && <span>{s.publisher}</span>}
          {s.type && <span class="badge">{SOURCE_TYPE_LABEL[s.type] ?? s.type}</span>}
        </div>
      </div>
    </li>
  ))}
</ol>
