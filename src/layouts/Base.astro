---
import '../styles/global.css';
import { getSite } from '../lib/site.ts';
import { fmtDate } from '../lib/format.ts';

interface Props {
  title: string;
  description?: string;
  /** Path beginning and ending with a slash, e.g. "/methodology/". */
  path?: string;
  index?: boolean;
  jsonLd?: object;
  ogType?: 'website' | 'article';
  wide?: boolean;
}
const { title, description = 'A neutral, source-backed record of who governed India, for how long, and what the evidence shows about their actions.', path = Astro.url.pathname, index = true, jsonLd, ogType = 'website' } = Astro.props;
const site = await getSite();
const siteName = 'India Explained';
const canonical = new URL(path, Astro.site ?? 'https://indiareview.pages.dev').href;
const fullTitle = path === '/' ? `${siteName}: who governed, for how long, and what the record shows` : `${title} | ${siteName}`;
const nav = [
  ['/', 'Home'],
  ['/categories/', 'Categories'],
  ['/actions/', 'Actions'],
  ['/dossiers/', 'Dossiers'],
  ['/debates/', 'Debates'],
  ['/governments/', 'Governments'],
  ['/parties/', 'Parties'],
  ['/compare/', 'Compare'],
  ['/compare/blocs/', 'Blocs'],
  ['/developing/', 'Developing'],
  ['/methodology/', 'Methodology'],
] as const;
const current = (href: string) => (href === '/' ? path === '/' : href === '/compare/' ? path === '/compare/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f6f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1119" media="(prefers-color-scheme: dark)" />
    {!index && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="India Explained: new actions, dossiers and developing items" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="India Explained, home">
          <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="2" y="5" width="28" height="4" rx="1" fill="currentColor" style="color:var(--accent)"/><rect x="2" y="14" width="19" height="4" rx="1" fill="currentColor" style="color:var(--accent)" opacity=".7"/><rect x="2" y="23" width="24" height="4" rx="1" fill="currentColor" style="color:var(--accent)" opacity=".45"/></svg>
          <span>India Explained</span>
        </a>
        <div class="tools">
          <form class="search-form" role="search" action="/search/" method="get">
            <label class="vh" for="hdr-q">Search the site</label>
            <input id="hdr-q" type="search" name="q" placeholder="Search" autocomplete="off" />
          </form>
          <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Switch colour theme">
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          </button>
          <button type="button" class="icon-btn menu-btn" data-menu-btn aria-expanded="false" aria-controls="primary-nav" aria-label="Menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
        <nav aria-label="Primary" id="primary-nav" style="display:contents">
          <ul class="nav" data-collapsed="true" id="nav-list">
            {nav.map(([href, label]) => (
              <li><a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a></li>
            ))}
            <li class="search-link"><a href="/search/" aria-current={path.startsWith('/search/') ? 'page' : undefined}>Search</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1" data-pagefind-body={index && !path.startsWith('/search') ? '' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <h2>Our pledge</h2>
            <p>
              Every government and party is described with the same template and scored on the same public rubric, by two scorers who
              do not see which party acted. This site does not say that any party is better or worse than another. Where evidence is
              thin or contested, it says so.
            </p>
            <p class="small">
              {site.lastUpdated ? <>Data last updated <time datetime={site.lastUpdated}>{fmtDate(site.lastUpdated)}</time>.</> : <>No entries have been published yet.</>}{' '}
              Content was built on <time datetime={site.asOf}>{fmtDate(site.asOf)}</time>.
            </p>
          </div>
          <div>
            <h2>Read</h2>
            <ul>
              <li><a href="/debates/">Debates</a></li>
              <li><a href="/indicators/">Indicators by period</a></li>
              <li><a href="/promises/">Promise tracker</a></li>
              <li><a href="/methodology/">Methodology</a></li>
              <li><a href="/corrections/">Corrections</a></li>
              <li><a href="/about/">About</a></li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>
          <div>
            <h2>Source</h2>
            <ul>
              <li><a href="https://github.com/PBhadoo/indiareview.pages.dev" rel="noopener">Repository on GitHub</a></li>
              <li><a href="https://github.com/PBhadoo/indiareview.pages.dev/issues" rel="noopener">Report an error or suggest a source</a></li>
            </ul>
            <p class="small">Data and code are open. See the repository for licence terms. This site sets no cookies and loads nothing from third parties.</p>
          </div>
        </div>
        <p class="fine">Figures are evidence points from a published rubric, not verdicts. Read <a href="/methodology/">how they are made</a> before citing them.</p>
      </div>
    </footer>

    <script>
      import '../scripts/chrome.ts';
    </script>
  </body>
</html>
