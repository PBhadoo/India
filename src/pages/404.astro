---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" path="/404/" description="This page does not exist." index={false}>
  <div class="wrap page-head">
    <p class="kicker">Error 404</p>
    <h1>Page not found</h1>
    <p class="lede">The address may have changed or may be mistyped. These places may help.</p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/actions/">All actions</a></li>
      <li><a href="/categories/">Browse by category</a></li>
      <li><a href="/governments/">Governments</a></li>
      <li><a href="/search/">Search</a></li>
    </ul>
  </div>
</Base>
