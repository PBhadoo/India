---
import Base from '../../layouts/Base.astro';
import ClaimBadge from '../../components/ClaimBadge.astro';
import DossierStatus from '../../components/DossierStatus.astro';
import DossierCard from '../../components/DossierCard.astro';
import SourceList from '../../components/SourceList.astro';
import SrcRef from '../../components/SrcRef.astro';
import ActionCard from '../../components/ActionCard.astro';
import { render } from 'astro:content';
import { getSite } from '../../lib/site.ts';
import { getCategory, subDisplayName } from '../../lib/taxonomy.ts';
import { fmtDate, isoDate, MINUS } from '../../lib/format.ts';
import { KIND_LABEL, CLAIM_TYPE_INFO, CLAIM_TYPE_ORDER, fmtLooseDate, looseDateIso, daysBetween, srcList, dossiersInCategory } from '../../lib/dossiers.ts';

export async function getStaticPaths() {
  const site = await getSite();
  return site.dossiers.map((d) => ({ params: { slug: d.slug }, props: { slug: d.slug } }));
}
const { slug } = Astro.props;
const site = await getSite();
const row = site.dossiers.find((x) => x.slug === slug)!;
const d = row.data;
const { Content } = await render(row.entry);
const cat = getCategory(d.category);
const sources = d.sources as { title: string; url: string; publisher?: string; type?: string }[];
const ongoing = d.status === 'ongoing';
const age = daysBetween(d.asOf, new Date(site.asOf + 'T00:00:00Z'));
const stale = ongoing && age > 45;

const unopened = sources.filter((s) => /not opened|search[- ]results?|search[- ]result|headline only|summary|did not load|fetch (failed|returned)|403/i.test(s.title)).length;
const timeline = d.timeline as any[];
const claims = d.claims as any[];
const positions = d.positions as any[];
const tables = d.tables as any[];
const notShown = d.notShown as string[];

const relatedActions = site.actions
  .filter((a) => a.data.category === d.category)
  .map((a) => ({ a, shared: a.data.subcategories.filter((s: string) => (d.subcategories ?? []).includes(s)).length }))
  .sort((p, q) => q.shared - p.shared || +new Date(q.a.data.date) - +new Date(p.a.data.date))
  .slice(0, 6)
  .map((x) => x.a);
const relatedDossiers = dossiersInCategory(site.dossiers, d.category, d.subcategories ?? []).filter((x) => x.slug !== slug).slice(0, 4);

const sections = [
  timeline.length ? ['timeline', 'Timeline'] : null,
  claims.length ? ['claims', 'Claims'] : null,
  positions.length ? ['positions', 'Positions'] : null,
  tables.length ? ['data', 'Data tables'] : null,
  ['not-shown', 'What these facts do not show'],
  ['sources', 'Sources'],
  ['related', 'Related entries'],
].filter(Boolean) as [string, string][];

const isNum = (v: unknown) => typeof v === 'number' || (typeof v === 'string' && /^[−-]?\d[\d,.]*%?$/.test(v.trim()) && v.trim() !== '');
const colNumeric = (t: any, j: number) => t.rows.length > 0 && t.rows.every((r: any[]) => r[j] == null || r[j] === '' || isNum(r[j]));
const showCell = (v: unknown) => (v == null || v === '' ? '–' : typeof v === 'number' ? String(v).replace(/^-/, MINUS) : typeof v === 'string' && /^-\d/.test(v) ? MINUS + v.slice(1) : String(v));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  dateModified: isoDate(d.asOf),
  inLanguage: 'en',
  mainEntityOfPage: new URL(`/dossiers/${slug}/`, Astro.site).href,
  publisher: { '@type': 'Organization', name: 'India Explained' },
  citation: sources.map((s) => s.url),
};
---
<Base title={d.title} path={`/dossiers/${slug}/`} description={d.summary} ogType="article" jsonLd={jsonLd}>
  <div class="wrap page-head dossier-head" data-pagefind-meta={`category:${cat?.name ?? d.category}`}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li><li><a href="/dossiers/">Dossiers</a></li>
        {cat && <li><a href={`/categories/${cat.id}/`}>{cat.name}</a></li>}
        <li><span aria-current="page">{d.title}</span></li>
      </ol>
    </nav>
    <div class="meta" style="font-size:.95rem">
      <span class="badge badge-kind">{KIND_LABEL[d.kind] ?? d.kind}</span>
      <DossierStatus status={d.status} />
      {cat && <a href={`/categories/${cat.id}/`}>{cat.name}</a>}
      {(d.subcategories ?? []).map((s: string) => <a href={`/categories/${d.category}/${s}/`}>{subDisplayName(s)}</a>)}
    </div>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>

    <div class={`banner asof-banner${stale ? ' stale' : ''}`} role="note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <p>
        <strong>Facts as of <time datetime={isoDate(d.asOf)}>{fmtDate(d.asOf)}</time>.</strong>{' '}
        Check sources for later developments.
        {unopened > 0 ? ` ${unopened} of ${sources.length} sources are labelled as seen only in search results or summaries and not opened in full; see each source label, and read statuses taken from them as "as reported".` : ' See each source label for how it was read.'}
        {ongoing ? ' This matter is ongoing, so statuses below may have changed.' : ' This matter is marked settled; later filings or orders may still exist.'}
        {stale && <> It was last checked {age} days ago.</>}
      </p>
    </div>
    <p class="note nopoints">A dossier is a fact file. It records what is on record and who said what; it does not give a verdict. It is not scored and earns or loses no party points. <a href="/methodology/#dossiers">How dossiers are written</a>.</p>

    <div class="head-tools">
      <ul class="anchors" aria-label="On this page">
        {sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ul>
      <button type="button" class="btn" id="print-btn" hidden>Print this page</button>
    </div>
  </div>

  <div class="wrap dossier-body">
    <div class="prose-body explainer"><Content /></div>

    {timeline.length > 0 && (
      <section class="block" id="timeline" aria-labelledby="h-tl">
        <h2 id="h-tl">Timeline</h2>
        <p class="small">In date order. Each item shows what kind of statement it is, who is the actor, and where it comes from.</p>
        <ol class="dtl">
          {timeline.map((t) => (
            <li class={`dtl-item dtl-${t.type ?? 'plain'}`}>
              <div class="dtl-head">
                <time datetime={looseDateIso(t.date)}>{fmtLooseDate(t.date)}</time>
                {t.type && <ClaimBadge type={t.type} />}
                {t.actor && <span class="dtl-actor">{t.actor}</span>}
              </div>
              <p class="dtl-event">{t.event}</p>
              <SrcRef refs={t.source} sources={sources} />
            </li>
          ))}
        </ol>
      </section>
    )}

    {claims.length > 0 && (
      <section class="block" id="claims" aria-labelledby="h-cl">
        <h2 id="h-cl">Claims</h2>
        <p class="small">Findings, official statements, data and events are on record. An <strong>allegation</strong> is a claim that no finding has established; it is marked with a dashed border, a warning triangle and the words "Not established", and always shows its status and any response.</p>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Claims, scrolls sideways on narrow screens">
          <table class="data claims stackable">
            <caption>Claims in this dossier<span class="small">Each claim shows its type, who made it, its current status and any response. Type is shown in words and symbols, not colour.</span></caption>
            <thead>
              <tr><th scope="col">Claim</th><th scope="col">Type</th><th scope="col">Made by</th><th scope="col">Status</th><th scope="col">Response</th><th scope="col">Source</th></tr>
            </thead>
            <tbody>
              {claims.map((c) => (
                <tr class={`claim-row claim-${c.type}`}>
                  <th scope="row" class="claim-text">
                    {c.type === 'allegation' && <span class="not-est">Not established by a finding</span>}
                    {c.claim}
                  </th>
                  <td data-label="Type"><ClaimBadge type={c.type} /></td>
                  <td data-label="Made by">{c.madeBy ?? <span class="muted">Not stated</span>}</td>
                  <td data-label="Status">{c.status ?? <span class="muted">Not stated</span>}</td>
                  <td data-label="Response">{c.response ?? (c.type === 'allegation' ? <span class="muted">No response recorded</span> : <span class="muted">Not applicable</span>)}</td>
                  <td data-label="Source"><SrcRef refs={c.source} sources={sources} prefix="" /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="legend-types">
          <h3>What the claim types mean</h3>
          <dl class="dl">
            {CLAIM_TYPE_ORDER.map((t) => <><dt><ClaimBadge type={t} /></dt><dd>{CLAIM_TYPE_INFO[t].definition}</dd></>)}
          </dl>
        </div>
      </section>
    )}

    {positions.length > 0 && (
      <section class="block" id="positions" aria-labelledby="h-pos">
        <h2 id="h-pos">Positions</h2>
        <p class="small">Who says what, paraphrased with attribution. Every holder gets a card of the same size and the same fields.</p>
        <ul class="pos-grid">
          {positions.map((p) => (
            <li class="card pos">
              <h3>{p.holder}</h3>
              <p>{p.position}</p>
              <SrcRef refs={p.source} sources={sources} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {tables.length > 0 && (
      <section class="block" id="data" aria-labelledby="h-data">
        <h2 id="h-data">Data tables</h2>
        <div class="stack">
          {tables.map((t, ti) => (
            <figure class="dtable">
              <div class="table-wrap" tabindex="0" role="region" aria-label={`${t.title}, scrolls sideways on narrow screens`}>
                <table class="data">
                  <caption>{t.title}{t.caption && <span class="small">{t.caption}</span>}</caption>
                  <thead>
                    <tr>{t.columns.map((c: string | number, j: number) => <th scope="col" class={colNumeric(t, j) && j > 0 ? 'num' : undefined}>{c}</th>)}</tr>
                  </thead>
                  <tbody>
                    {t.rows.map((r: unknown[]) => (
                      <tr>
                        {r.map((v, j) => j === 0 ? <th scope="row">{showCell(v)}</th> : <td class={colNumeric(t, j) ? 'num' : undefined}>{showCell(v)}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <figcaption class="small">Source: {srcList(t.source).length ? <SrcRef refs={t.source} sources={sources} prefix="" /> : <span class="muted">not stated</span>}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="block" id="not-shown" aria-labelledby="h-ns">
      <div class="callout notshown">
        <h2 id="h-ns">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.6 2.6 0 1 1 3.7 2.3c-.8.4-1.2 1-1.2 1.8M12 17v.1"/></svg>
          What these facts do not show
        </h2>
        {notShown.length ? <ul>{notShown.map((n) => <li>{n}</li>)}</ul> : <p>No limits are recorded for this dossier yet.</p>}
      </div>
    </section>

    <section class="block" id="sources" aria-labelledby="h-src">
      <h2 id="h-src">Sources</h2>
      <p class="small">Numbers in square brackets refer to this list. Types: primary, official data and court sources are weighed above media and academic ones.</p>
      <SourceList sources={sources} idPrefix="src-" />
      <p class="small" style="margin-top:1rem">
        Facts as of <time datetime={isoDate(d.asOf)}>{fmtDate(d.asOf)}</time>. Last reviewed <time datetime={isoDate(d.lastReviewed)}>{fmtDate(d.lastReviewed)}</time>.
        <a href={`/corrections/?from=${encodeURIComponent(`/dossiers/${slug}/`)}&title=${encodeURIComponent(d.title)}`}>Report an error</a>.
      </p>
      <p class="print-only small">Printed from {new URL(`/dossiers/${slug}/`, Astro.site).href}. Facts as of {fmtDate(d.asOf)}; check the sources for later developments.</p>
    </section>

    <section class="block" id="related" aria-labelledby="h-rel">
      <h2 id="h-rel">Related entries</h2>
      {relatedActions.length === 0 && relatedDossiers.length === 0 ? (
        <div class="empty"><p>No other entries are filed under {cat?.name ?? 'this category'} yet.</p></div>
      ) : (
        <>
          {relatedActions.length > 0 && (
            <>
              <h3>Actions in {cat?.name ?? d.category}</h3>
              <ul class="alist">{relatedActions.map((a) => <li><ActionCard action={a} site={site} showCategory={false} /></li>)}</ul>
            </>
          )}
          {relatedDossiers.length > 0 && (
            <>
              <h3 style="margin-top:1.6rem">Other dossiers in {cat?.name ?? d.category}</h3>
              <ul class="alist">{relatedDossiers.map((x) => <li><DossierCard dossier={x} showCategory={false} compact /></li>)}</ul>
            </>
          )}
        </>
      )}
    </section>
  </div>
</Base>
<script>
  const b = document.getElementById('print-btn');
  if (b) {
    b.hidden = false;
    b.addEventListener('click', () => window.print());
  }
</script>
